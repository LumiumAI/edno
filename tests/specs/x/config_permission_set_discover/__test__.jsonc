{
  "tempDir": true,
  "envs": {
    "EDNO_DIR": "$PWD/edno_dir"
  },
  // Companion to `config_permission_set` (issue #35991): the permission set is
  // defined in a cwd `edno.json` and selected with `-P=write`, WITHOUT an
  // explicit `--config`. The re-run subprocess runs the installed bin FILE
  // (under `edno_x_cache`), so its config auto-discovery anchors on the install
  // dir, NOT the user's cwd — it would find the internal temp `edno.json` (which
  // has no permission set) and fail. `edno x` must therefore resolve the user's
  // auto-discovered cwd `edno.json` and forward it explicitly (alongside
  // `-P=write`) so the child resolves the set — matching `edno run -P=write
  // npm:@ednotest/try-write`. Previously the npm auto-install path forwarded the
  // internal temp `edno.json`, so the set could not be found.
  "tests": {
    "discover_config": {
      "args": "x -y -P=write npm:@ednotest/try-write",
      "output": "[WILDCARD]write succeeded\n"
    }
  }
}
