{
  "tempDir": true,
  "envs": {
    "EDNO_DIR": "$PWD/edno_dir"
  },
  "steps": [{
    // Structured `minimumDependencyAge` (age + exclude) in the cwd edno.json
    // must not break `edno x` or make it diverge from
    // `edno run jsr:@ednotest/x-min-dep-age`, which selects the newest version
    // 2.0.0 (a directly-run `jsr:` specifier is not subject to the age cutoff).
    // Before the #35991 review fix, the config was forwarded as a scalar flag,
    // dropping the exclude and diverging from `edno run`.
    "args": "x -y jsr:@ednotest/x-min-dep-age",
    "output": "[WILDCARD]\n2.0.0\n"
  }]
}
