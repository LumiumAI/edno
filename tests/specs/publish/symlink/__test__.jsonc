{
  "tempDir": true,
  "envs": {
    "DISABLE_JSR_PROVENANCE": "true",
    "EDNO_TESTING_DISABLE_GIT_CHECK": "1"
  },
  "steps": [{
    "args": ["eval", "Edno.symlinkSync('./mod.ts', './symlink');"],
    "output": "[WILDCARD]"
  }, {
    "args": "publish --token 'sadfasdf' --dry-run",
    "output": "symlink.out",
    "exitCode": 0
  }]
}
