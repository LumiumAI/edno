{
  "tempDir": true,
  "envs": {
    "EDNO_DIR": "$PWD/edno_dir"
  },
  "steps": [
    {
      // the trust policy in the .npmrc forces the full packument to be
      // fetched, which is where the `_npmUser.trustedPublisher`
      // publishing-trust signal lives
      "args": "install npm:@ednotest/trusted-publisher",
      "output": "[WILDCARD]"
    },
    {
      "args": "run -A check.ts",
      "output": "check.out"
    }
  ]
}
