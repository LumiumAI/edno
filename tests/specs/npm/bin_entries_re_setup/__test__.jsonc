{
  "tempDir": true,
  "steps": [{
    "args": "install npm:@ednotest/print-version@2.0.0",
    "output": "[WILDCARD]"
  }, {
    "commandName": "./node_modules/.bin/print-version",
    "args": "",
    "output": "2.0.0\n",
    "if": "unix"
  }, {
    "args": "outdated --update @ednotest/print-version@1.0.0",
    "output": "[WILDCARD]"
  }, {
    "commandName": "./node_modules/.bin/print-version",
    "args": "",
    "output": "1.0.0\n",
    "if": "unix"
  }, {
    "args": "outdated --update @ednotest/print-version@2.0.0",
    "output": "[WILDCARD]"
  }, {
    "commandName": "./node_modules/.bin/print-version",
    "args": "",
    "output": "2.0.0\n",
    "if": "unix"
  }]
}
