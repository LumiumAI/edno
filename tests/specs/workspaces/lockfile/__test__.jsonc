{
  "tempDir": true,
  "steps": [{
    "cwd": "pkg",
    "args": "test",
    "output": "test_pkg.out"
  }, {
    // the lockfile should always go to the workspace root
    "args": [
      "eval",
      "try { Edno.readTextFileSync('pkg/edno.lock'); console.log('should not run'); } catch {} console.log(Edno.readTextFileSync('edno.lock'))"
    ],
    "output": "expected-lock.out"
  }, {
    "args": "test",
    "output": "test_root.out"
  }, {
    "args": [
      "eval",
      "try { Edno.readTextFileSync('pkg/edno.lock'); console.log('should not run'); } catch {} console.log(Edno.readTextFileSync('edno.lock'))"
    ],
    "output": "expected-lock.out"
  }]
}
