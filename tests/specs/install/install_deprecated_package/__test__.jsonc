{
  "tempDir": true,
  "steps": [
    {
      "args": "install npm:@ednotest/deprecated-package",
      "output": "install.out"
    },
    {
      // make sure the dep got cached
      "args": "run --cached-only main.js",
      "exitCode": 0,
      "output": ""
    },
    {
      "args": [
        "eval",
        "console.log(Edno.readTextFileSync('package.json').trim())"
      ],
      "output": "package.json.out"
    }
  ]
}
