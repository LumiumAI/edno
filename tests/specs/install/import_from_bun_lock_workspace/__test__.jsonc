{
  "tempDir": true,
  "steps": [
    {
      // No edno.lock, package-lock.json, or pnpm-lock.yaml. `edno install`
      // should seed edno.lock from bun.lock, including the workspace member's
      // deps (bun records every workspace's requirements under `workspaces`).
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Edno.readTextFileSync('edno.lock').trim())"
      ],
      "output": "edno.lock.out"
    }
  ]
}
