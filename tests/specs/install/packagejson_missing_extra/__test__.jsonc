{
  "tempDir": true,
  "tests": {
    "missing_bin": {
      "steps": [
        {
          "args": "install npm:ednotest-packagejson-missing-info@1.0.0-missingbin",
          "output": "missingbin.out"
        },
        {
          "args": "run -A ./has-bin.ts ednotest",
          "output": ""
        }
      ]
    },
    "binding_gyp_scripts": {
      "steps": [
        {
          "args": "install npm:ednotest-packagejson-missing-info@0.7.0-bindinggyp",
          "output": "bindinggyp.out"
        }
      ]
    },
    "missing_deprecated": {
      "steps": [
        {
          "args": "install npm:ednotest-packagejson-missing-info@0.2.5-missingdeprecated",
          "output": "missingdeprecated.out"
        }
      ]
    },
    "missing_deprecated_with_lazy_caching": {
      "steps": [
        {
          "args": "install --unstable-npm-lazy-caching npm:ednotest-packagejson-missing-info@0.2.5-missingdeprecated",
          "output": "missingdeprecated.out"
        }
      ]
    }
  }
}
