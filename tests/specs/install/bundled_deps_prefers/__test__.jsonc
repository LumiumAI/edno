{
  "tempDir": true,
  "steps": [{
    // we have a npm:@ednotest/add locally in the lockfile
    // and we want to ensure that's not used by the npm:@ednotest/bundled-deps
    "args": "install --lockfile-only",
    "output": "[WILDCARD]"
  }, {
    "args": "run -A npm:@ednotest/bundled-add 1 2",
    "output": "output.out"
  }]
}
