{
  "tempDir": true,
  "steps": [
    {
      // No edno.lock or package-lock.json — `edno install` should seed
      // edno.lock from pnpm-lock.yaml instead.
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Edno.readTextFileSync('edno.lock').trim())"
      ],
      "output": "edno.lock.out"
    },
    {
      "args": "run --cached-only main.js",
      "output": "3\n"
    }
  ]
}
