{
  "tempDir": true,
  "steps": [
    {
      "args": "install --lockfile-only npm:@ednotest/esm-basic",
      "output": "install.out"
    },
    {
      // Verify node_modules was not created. Also that the lockfile was created and contains the package
      "args": [
        "eval",
        " try { Edno.statSync('node_modules') } catch { console.log(true) } const lock = JSON.parse(Edno.readTextFileSync('edno.lock')); console.log(Object.keys(lock.npm).includes('@ednotest/esm-basic@1.0.0'))"
      ],
      "output": "true\ntrue\n"
    },
    {
      // Now run install without --lockfile-only to create node_modules
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      // Verify node_modules was created this time
      "args": [
        "eval",
        "console.log(Edno.statSync('node_modules').isDirectory)"
      ],
      "output": "true\n"
    }
  ]
}
