{
  "tempDir": true,
  "steps": [
    {
      "args": "install --allow-import",
      "output": "install.out"
    },
    {
      // ensure deps are actually cached
      "args": "run --cached-only --allow-import main.js",
      "output": ""
    },
    {
      // check for lockfile
      "args": [
        "eval",
        "console.log(Edno.readTextFileSync('./edno.lock').trim())"
      ],
      "output": "edno.lock.out"
    }
  ]
}
