{
  "tempDir": true,
  "tests": {
    "package_json": {
      "steps": [
        {
          "args": "add --save-optional npm:@ednotest/esm-basic",
          "output": "[WILDCARD]"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "package.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.statSync('node_modules/@ednotest/esm-basic').isDirectory)"
          ],
          "output": "true\n"
        }
      ]
    },
    "short_flag_moves_section": {
      "steps": [
        {
          "args": [
            "eval",
            "Edno.writeTextFileSync('package.json', JSON.stringify({ dependencies: { '@ednotest/esm-basic': '^1.0.0' } }, null, 2))"
          ],
          "output": ""
        },
        {
          "args": "add -O npm:@ednotest/esm-basic",
          "output": "[WILDCARD]"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "moved.package.json.out"
        }
      ]
    },
    "conflicts_with_dev": {
      "args": "add --save-optional --dev npm:@ednotest/esm-basic",
      "output": "conflict.out",
      "exitCode": 1
    }
  }
}
