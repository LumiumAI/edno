{
  "tempDir": true,
  "tests": {
    "updates_lockfile": {
      "steps": [
        {
          "args": "add npm:@ednotest/esm-basic npm:@ednotest/say-hello",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('edno.lock'))"
          ],
          "output": "lockfile_add.out"
        },
        {
          "args": "remove @ednotest/esm-basic @ednotest/say-hello",
          "output": "remove.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('edno.lock'))"
          ],
          "output": "lockfile_remove.out"
        }
      ]
    }
  }
}
