{
  "tempDir": true,
  "tests": {
    "prefers_package_json_from_config": {
      // With "preferPackageJson": true in edno.json, `edno add` (no flag)
      // routes all packages into package.json.
      "steps": [
        {
          "args": "add npm:@ednotest/esm-basic jsr:@ednotest/add",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "package.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('edno.json').trim())"
          ],
          "output": "edno.json.out"
        }
      ]
    },
    "creates_package_json_if_missing": {
      // With "preferPackageJson": true but no package.json, one is created.
      "steps": [
        {
          "args": [
            "eval",
            "Edno.removeSync('package.json')"
          ],
          "output": ""
        },
        {
          "args": "add npm:@ednotest/esm-basic",
          "output": "add_create.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "created_package.json.out"
        }
      ]
    }
  }
}
