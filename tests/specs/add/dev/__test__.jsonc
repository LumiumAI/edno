{
  "tempDir": true,
  "tests": {
    "package_json": {
      "steps": [
        {
          "args": "add --dev npm:@ednotest/esm-basic",
          "output": "add_packagejson.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "package.json.out"
        }
      ]
    },
    "edno_json": {
      "steps": [
        {
          "args": ["eval", "Edno.removeSync('package.json')"],
          "output": ""
        },
        {
          "args": "add --dev npm:@ednotest/esm-basic",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('edno.json').trim())"
          ],
          "output": "edno.json.out"
        }
      ]
    }
  }
}
