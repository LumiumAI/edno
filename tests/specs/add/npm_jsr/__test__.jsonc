{
  "tempDir": true,
  "tests": {
    "npm": {
      "args": "add --npm @ednotest/esm-basic jsr:@ednotest/add npm:chalk",
      "output": "npm.out"
    },
    "jsr": {
      "args": "add --jsr npm:@ednotest/esm-basic @ednotest/add npm:chalk",
      "output": "jsr.out"
    },
    "npm_install": {
      "args": "install --npm @ednotest/esm-basic jsr:@ednotest/add npm:chalk",
      "output": "npm.out"
    },
    "jsr_install": {
      "args": "install --jsr npm:@ednotest/esm-basic @ednotest/add npm:chalk",
      "output": "jsr.out"
    },
    "same_prefix": {
      "steps": [
        {
          "args": "add --jsr jsr:@ednotest/add",
          "output": "Add jsr:@ednotest/add@1.0.0\nDownload [WILDCARD]\n"
        },
        {
          "args": "add --npm npm:chalk",
          "output": "Add npm:chalk@5.0.1\nDownload [WILDCARD]\n"
        }
      ]
    }
  }
}
