{
  "tempDir": true,
  "tests": {
    "npm_prefers_package_json": {
      "steps": [
        {
          "args": "add npm:@ednotest/esm-basic jsr:@ednotest/add npm:@ednotest/say-hello",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "npm_prefer_package.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('edno.json').trim())"
          ],
          "output": "npm_prefer_deno.json.out"
        }
      ]
    },
    "only_creates_deno_json_if_no_config": {
      "steps": [
        {
          "args": ["eval", "Edno.removeSync('edno.json')"],
          "output": ""
        },
        {
          "args": "add npm:@ednotest/esm-basic",
          "output": "add_esm_basic.out"
        },
        {
          "args": [
            "eval",
            "try { Edno.statSync('edno.json'); console.log('bad'); } catch (e) { if (e instanceof Edno.errors.NotFound) { console.log('good'); } else { console.log('bad error', e); }}"
          ],
          "output": "good\n"
        }
      ]
    },
    "only_prefers_package_json_if_closer": {
      "steps": [
        {
          "cwd": "./subdir",
          "args": "add npm:@ednotest/esm-basic jsr:@ednotest/add npm:@ednotest/say-hello",
          "output": "[WILDCARD]"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "{}\n"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('./subdir/edno.json').trim())"
          ],
          "output": "subdir/prefer_if_closer_deno.json.out"
        }
      ]
    }
  }
}
