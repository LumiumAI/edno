{
  "tempDir": true,
  "tests": {
    "does_not_modify_config": {
      "steps": [
        {
          "args": "add --no-save npm:@ednotest/esm-basic",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('package.json').trim())"
          ],
          "output": "package.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('edno.json').trim())"
          ],
          "output": "edno.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.statSync('node_modules/@ednotest/esm-basic').isDirectory)"
          ],
          "output": "true\n"
        }
      ]
    }
  }
}
