{
  "tempDir": true,
  "tests": {
    "edno_json": {
      "steps": [{
        "commandName": "npm",
        "args": "install",
        "output": "[WILDCARD]"
      }, {
        "args": "task say",
        "output": "package_json_say.out"
      }, {
        "args": "task edno-say",
        "output": "edno_json_say.out"
      }]
    },
    "no_deno_json": {
      "steps": [{
        "args": [
          "eval",
          "Edno.removeSync('edno.json')"
        ],
        "output": ""
      }, {
        "commandName": "npm",
        "args": "install",
        "output": "[WILDCARD]"
      }, {
        "args": "task say",
        "output": "package_json_say.out"
      }, {
        // byonm flag
        "args": "task --unstable-byonm say",
        "output": "package_json_say.out"
      }, {
        "args": [
          "eval",
          "try { Edno.statSync('node_modules/.edno'); } catch (e) { if (e instanceof Edno.errors.NotFound) { console.log('good'); } else { throw new Error('bad'); } }"
        ],
        "output": "good\n"
      }]
    }
  }
}
