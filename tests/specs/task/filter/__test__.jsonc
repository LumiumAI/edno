{
  "tests": {
    "npm_all": {
      "cwd": "./npm",
      "args": "task --filter * dev",
      "output": "npm_all.out"
    },
    "npm_exact": {
      "cwd": "./npm",
      "args": "task --filter foo dev",
      "output": "npm_exact.out"
    },
    "npm_multi": {
      "cwd": "./npm_multi",
      "args": "task --filter multi-* dev",
      "output": "npm_multi.out"
    },
    "npm_scoped_exact": {
      "cwd": "./npm_scoped",
      "args": "task --filter @foo/bar dev",
      "output": "npm_scoped_exact.out"
    },
    "npm_scoped_multi": {
      "cwd": "./npm_scoped",
      "args": "task --filter @foo/* dev",
      "output": "npm_scoped_multi.out"
    },
    "npm_workspace_order": {
      "cwd": "./npm_workspace_order",
      "args": "task --filter @foo/* dev",
      "output": "npm_workspace_order.out"
    },
    "npm_filter_no_match_no_task": {
      "cwd": "./npm",
      "args": "task --filter @asdf",
      "output": "npm_filter_no_match_no_task.out"
    },
    "npm_filter_no_task": {
      "cwd": "./npm",
      "args": "task --filter *",
      "output": "npm_filter_no_task.out"
    },
    "npm_recursive": {
      "cwd": "./npm",
      "args": "task -r dev",
      "output": "npm_recursive.out"
    },
    "npm_recursive_no_pkg": {
      "cwd": "./npm_recursive_no_pkg",
      "args": "task -r dev",
      "output": "npm_recursive_no_pkg.out"
    },
    "npm_filter_recursive": {
      "cwd": "./npm",
      "args": "task -r --filter foo dev",
      "output": "npm_filter_recursive.out"
    },
    "edno_all": {
      "cwd": "./edno",
      "args": "task --filter * dev",
      "output": "edno_all.out"
    },
    "edno_exact": {
      "cwd": "./edno",
      "args": "task --filter foo dev",
      "output": "edno_exact.out"
    },
    "edno_scoped_exact": {
      "cwd": "./edno_scoped",
      "args": "task --filter @foo/bar dev",
      "output": "edno_scoped_exact.out"
    },
    "edno_scoped_multi": {
      "cwd": "./edno_scoped",
      "args": "task --filter @foo/* dev",
      "output": "edno_scoped_multi.out"
    },
    "edno_workspace_order": {
      "cwd": "./edno_workspace_order",
      "args": "task --filter @foo/* dev",
      "output": "edno_workspace_order.out"
    },
    "edno_filter_no_match_no_task": {
      "cwd": "./edno",
      "args": "task --filter @asdf",
      "output": "edno_filter_no_match_no_task.out"
    },
    "edno_filter_no_task": {
      "cwd": "./edno",
      "args": "task --filter *",
      "output": "edno_filter_no_task.out"
    },
    "edno_recursive": {
      "cwd": "./edno",
      "args": "task -r dev",
      "output": "edno_recursive.out"
    },
    "edno_recursive_no_pkg": {
      "cwd": "./edno_recursive_no_pkg",
      "args": "task -r dev",
      "output": "edno_recursive_no_pkg.out"
    },
    "edno_filter_recursive": {
      "cwd": "./edno",
      "args": "task -r --filter @edno/foo dev",
      "output": "edno_filter_recursive.out"
    },
    // Regression test for https://github.com/denoland/deno/issues/28620
    // `--filter` should also match the workspace member's directory name,
    // not just the `name` field in its edno.json / package.json.
    "edno_dir_name_match": {
      "cwd": "./edno_dir_name_match",
      "args": "task --filter foo-dir dev",
      "output": "edno_dir_name_match.out"
    },
    // Workspace root should not be matched by its directory name even if it
    // has a `name` field. Here the filter matches the root's directory name
    // but not its package name, so the root must not be selected.
    "edno_root_not_matched_by_dir": {
      "cwd": "./edno_root_with_name",
      "args": "task --filter edno_root_with_name dev",
      "output": "edno_root_not_matched_by_dir.out"
    },
    // A workspace member without a `name` field should still be matchable
    // by its directory name.
    "edno_member_no_name": {
      "cwd": "./edno_member_no_name",
      "args": "task --filter my-lib dev",
      "output": "edno_member_no_name.out"
    }
  }
}
