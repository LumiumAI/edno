{
  "tempDir": true,
  "tests": {
    "upgrades": {
      "steps": [
        {
          "args": "install npm:chalk",
          "output": "[WILDCARD]"
        },
        {
          "args": ["eval", "console.log(Edno.readTextFileSync('edno.lock'))"],
          "output": "edno.lock.json.out"
        },
        {
          "args": "install jsr:@ednotest/add",
          "output": "[WILDCARD]"
        },
        {
          "args": [
            "eval",
            "console.log(Edno.readTextFileSync('edno.lock'))"
          ],
          "output": "edno.lock.v5.json.out"
        }
      ]
    },
    "does_not_redownload": {
      "steps": [
        {
          "args": [
            "eval",
            "Edno.writeTextFileSync('edno.json', '{\"nodeModulesDir\":\"auto\"}')"
          ],
          "output": ""
        },
        {
          "args": "install npm:chalk",
          "output": "[WILDCARD]"
        },
        {
          "args": "clean -q",
          "output": ""
        },
        {
          "args": "clean -q",
          "output": ""
        },
        // lockfile v5 doesn't need to redownload
        {
          "args": "run -A empty.js",
          "output": ""
        }
      ]
    }
  }
}
