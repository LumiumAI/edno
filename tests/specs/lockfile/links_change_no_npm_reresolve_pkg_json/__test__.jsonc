{
  "tempDir": true,
  "envs": {
    "EDNO_DIR": "$PWD/edno_dir"
  },
  "steps": [
    {
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      "args": "run -A --no-lock strip_links.ts ./edno.lock",
      "output": ""
    },
    {
      "args": "run -A --no-lock rm_packument.ts ./edno_dir/npm/localhost_4260/@ednotest/esm-basic/registry.json",
      "output": ""
    },
    {
      "args": "run --cached-only main.ts",
      "output": "main.out"
    }
  ]
}
