{
  "tempDir": true,
  "envs": {
    "EDNO_DIR": "$PWD/edno_dir"
  },
  "steps": [
    {
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      "args": "run -A --no-lock ./rm-version.ts $PWD/edno_dir/npm/localhost_4260/@ednotest/add/registry.json 1.0.0",
      "output": "[WILDCARD]"
    },
    {
      "args": "run -A --no-lock ./mv.ts ./edno.lock.old ./edno.lock",
      "output": ""
    },
    // trigger a lockfile update
    {
      "args": "install npm:chalk",
      "output": "[WILDCARD]"
    },
    {
      "args": "remove npm:chalk",
      "output": "[WILDCARD]"
    },
    {
      "args": [
        "eval",
        "--no-lock",
        "console.log(Edno.readTextFileSync('./edno.lock').trim())"
      ],
      "output": "edno.lock.out"
    }
  ]
}
