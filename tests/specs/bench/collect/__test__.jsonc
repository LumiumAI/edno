{
  "tests": {
    "ignore": {
      "args": "bench --ignore=collect/ignore collect",
      "output": "collect.out"
    },
    "config_sub_dir": {
      "args": "bench --config collect/edno.jsonc collect",
      "output": "collect.out"
    },
    "config_sub_dir_with_exclude": {
      "args": "bench --config collect/edno2.jsonc collect",
      "output": "collect2.out"
    },
    "config_malformed": {
      "args": "bench --config collect/edno.malformed.jsonc",
      "exitCode": 1,
      "output": "collect_with_malformed_config.out"
    }
  }
}
