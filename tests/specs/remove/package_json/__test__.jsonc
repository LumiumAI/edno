{
  "tempDir": true,
  "steps": [
    {
      "args": "remove @ednotest/add",
      "output": "rm_add.out"
    },
    {
      "args": [
        "eval",
        "console.log(Edno.readTextFileSync('package.json').trim())"
      ],
      "output": "rm_add_package.json.out"
    },
    {
      "args": "remove @ednotest/esm-basic",
      "output": "rm_esm_basic.out"
    },
    {
      "args": [
        "eval",
        "console.log(Edno.readTextFileSync('package.json').trim())"
      ],
      "output": "rm_esm_basic_package.json.out"
    }
  ]
}
