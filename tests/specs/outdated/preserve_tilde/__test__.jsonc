{
  "tempDir": true,
  "steps": [
    {
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      "args": "update",
      "output": "update.out"
    },
    {
      "args": [
        "eval",
        "const content = Edno.readTextFileSync('./edno.json'); const imports = JSON.parse(content).imports; const version = imports['@ednotest/has-patch-versions']; console.log(version);"
      ],
      "output": "edno.json.version.out"
    }
  ]
}
