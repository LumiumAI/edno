{
  "if": "notWindowsArm",
  "tempDir": true,
  "steps": [
    {
      "args": "eval Edno.copyFileSync(Edno.execPath(),'./edno_copy');",
      "exitCode": 0,
      "output": ""
    },
    {
      "commandName": "./edno_copy",
      "args": "upgrade --force --version 1.43.2",
      "output": "upgrade.out",
      "exitCode": 0,
      "flaky": true
    },
    {
      "commandName": "./edno_copy",
      "args": "--version",
      "exitCode": 0,
      "output": "version.out"
    }
  ]
}
