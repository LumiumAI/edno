{
  "tempDir": true,
  "envs": {
    "EDNO_DIR": "$PWD/edno_dir"
  },
  "steps": [{
    // create edno dir
    "args": "run http://localhost:4545/echo.ts hi",
    "output": "[WILDCARD]"
  }, {
    "args": [
      "eval",
      "console.log(Edno.statSync('./edno_dir') != null)"
    ],
    "output": "true\n"
  }, {
    "args": "clean",
    "output": "Removed [WILDLINE]/edno_dir ([WILDCARD]files, [WILDCARD])\n"
  }, {
    "envs": {
      // use a new dir to avoid creating the old one
      "EDNO_DIR": "$PWD/other"
    },
    "args": "clean",
    "output": ""
  }, {
    "envs": {
      // use a new dir to avoid creating the old one
      "EDNO_DIR": "$PWD/other"
    },
    "args": [
      "eval",
      "try { Edno.statSync('./edno_dir') } catch (_) { console.log(true) }"
    ],
    "output": "true\n"
  }]
}
